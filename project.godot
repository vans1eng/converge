; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Converge"
config/version="0.1.0"
run/main_scene="uid://cxb0sfsedohyq"
config/project_settings_override="user://startup_theme.cfg"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
config/icon="res://assets/icons/converge.png"
config/windows_native_icon="res://assets/icons/converge.ico"

[autoload]

ThemeManager="*res://scripts/autoload/theme_manager.gd"
AudioManager="*uid://coxighsrtpfsd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/borderless=true
window/size/transparent=true
window/size/no_focus=true
window/size/window_width_override=3840
window/size/window_height_override=2160
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[editor]

movie_writer/video_quality=0.95
movie_writer/movie_file="/Users/fansheng/Desktop/converge video/record1.avi"

